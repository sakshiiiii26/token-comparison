# ========================================================
# Binjwa AI Cost Platform - Production Environment Variables
# ========================================================

# Database
DATABASE_NAME=binjwa_ai_cost
MONGODB_PORT=27017

# Backend Configuration
BACKEND_PORT=8000
JWT_SECRET_KEY=generate_a_secure_random_32_byte_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External API Keys (OpenRouter for AI chat completion)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# CORS Configuration (comma-separated or * for wildcard)
CORS_ORIGINS=*

# Frontend Configuration
FRONTEND_PORT=80
# Leave empty for Docker Compose unified Nginx proxy; set to backend URL if hosting separately:
VITE_API_BASE_URL=
