# Backend API Base URL
# For local development against localhost:8000:
# VITE_API_BASE_URL=http://localhost:8000
#
# For production behind Nginx reverse proxy (same domain):
# VITE_API_BASE_URL=
#
# For production hosted on separated domain (e.g. Render / Railway):
# VITE_API_BASE_URL=https://api-binjwa.onrender.com
VITE_API_BASE_URL=http://localhost:8000
